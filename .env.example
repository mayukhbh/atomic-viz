# Public HTTPS deployment origin for absolute Open Graph URLs; optional override of Vercel system URLs, never a secret.
SITE_URL=
# Optional smoke target; unset starts a local Vite preview server.
SMOKE_URL=
# Optional screenshot/measurement output directory; defaults to artifacts/smoke.
SMOKE_OUTPUT=
# Set to 1 for the five 1440px performance scenarios only.
PERF_ONLY=
# Set to 1 to explicitly request software WebGL; results are not real-GPU evidence.
SOFTWARE_WEBGL=
# Optional existing Chromium executable for the smoke runner; normally use Playwright's pinned browser.
CHROMIUM_PATH=

# Provided automatically by Vercel: deployment hostname without protocol.
VERCEL_URL=
# Provided automatically by Vercel: production hostname without protocol.
VERCEL_PROJECT_PRODUCTION_URL=
# Provided automatically by Vercel: preview or production.
VERCEL_ENV=
# Provided automatically by Vercel: 1 on hosted builds.
VERCEL=
# Optional Node environment; production requires a configured HTTPS metadata origin.
NODE_ENV=
